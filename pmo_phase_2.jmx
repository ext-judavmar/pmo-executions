              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonOutput

def count = vars.get(&apos;wf_id_matchNr&apos;) as Integer
def payloadList = []

for (int i = 1; i &lt;= count; i++) {
    def id = vars.get(&quot;wf_id_${i}&quot;)
    def request_id = vars.get(&quot;wf_request_id_${i}&quot;)
    payloadList &lt;&lt; [id: id, request_id: request_id]
}

def payloadJson = JsonOutput.toJson(payloadList)
vars.put(&quot;payload&quot;, payloadJson)</stringProp>
