                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

// Access the captured JSON response from the previous HTTP Request
def jsonResponse = vars.get(&quot;jsonResponse&quot;)

// Check if jsonResponse is not null or empty
if (jsonResponse == null || jsonResponse.trim().isEmpty()) {
    log.error(&quot;JSON response is null or empty.&quot;)
    return
}

// Parse the JSON response
def jsonSlurper = new JsonSlurper()
def jsonObject

try {
    jsonObject = jsonSlurper.parseText(jsonResponse)
} catch (Exception e) {
    log.error(&quot;Failed to parse JSON response: &quot; + e.message)
    return
}

// Initialize counter for &apos;id&apos; items
int idCount = 0 // Declare idCount with type int

// Function to count &apos;id&apos; items
def countIds(obj) {
    if (obj instanceof Map) {
        // Check if the current object has an &apos;id&apos; key
        if (obj.containsKey(&apos;id&apos;)) {
            idCount++ // Increment idCount
        }
        // Recurse for nested objects
        obj.each { key, value -&gt;
            countIds(value)
        }
    } else if (obj instanceof List) {
        // Recurse for each item in the list
        obj.each { item -&gt;
            countIds(item)
        }
    }
}

// Count &apos;id&apos; items in the JSON object
countIds(jsonObject)

// Log the count of &apos;id&apos; items
log.info(&quot;Number of &apos;id&apos; items: &quot; + idCount)

// Optionally, store the count in a JMeter variable for later use
vars.put(&quot;idCount&quot;, idCount.toString())</stringProp>
