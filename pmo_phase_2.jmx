              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="idCount  JSR223 PostProcessor" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

// Get the response body from the previous HTTP Request
def responseBody = prev.getResponseDataAsString()

// Store the JSON response in a JMeter variable
vars.put(&quot;jsonResponse&quot;, responseBody)

// Log to confirm the variable is set
log.info(&quot;Captured JSON Response: &quot; + responseBody)

// Parse the JSON response
def jsonSlurper = new JsonSlurper()
def jsonArray

try {
    // Assuming the response is a JSON array
    jsonArray = jsonSlurper.parseText(responseBody) // Parse the JSON response
} catch (Exception e) {
    log.error(&quot;Failed to parse JSON response: &quot; + e.message)
    return
}

// Initialize counter for &apos;id&apos; values
int idCount = 0

// Iterate through the array and extract &apos;id&apos; values
jsonArray.eachWithIndex { item, index -&gt;
    if (item instanceof Map &amp;&amp; item.containsKey(&apos;id&apos;)) {
        // Create a variable name like employId_0, employId_1, etc.
        String employeeIdVariable = &quot;employeeId_&quot; + index
        // Store the &apos;id&apos; in the variable
        vars.put(employeeIdVariable, item.id.toString())
        log.info(&quot;Stored &quot; + employeeIdVariable + &quot;: &quot; + item.id) // Log the stored id
        idCount++ // Increment idCount for each &apos;id&apos; found
    }
}

// Log the total number of &apos;id&apos; values stored
log.info(&quot;Total number of &apos;id&apos; values stored: &quot; + idCount)

// Optionally, store the count in a JMeter variable for later use
vars.put(&quot;idCount&quot;, idCount.toString())</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="employeeIdsArray  JSR223 PostProcessor" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// Assuming idCount has been defined and populated earlier in your script
def idCount = Integer.parseInt(vars.get(&quot;idCount&quot;)) // Get idCount from JMeter variable

// Initialize an empty list to hold the employee IDs
def employeeIds = [] as ArrayList

// Loop through the range of idCount to populate the employeeIds array
for (int i = 0; i &lt; idCount; i++) {
    String employeeIdVariable = &quot;${&apos;employeeId_&apos; + i}&quot; // Create variable name dynamically
    employeeIds.add(vars.get(employeeIdVariable)) // Get the value and add to the list
}

// Convert the list to a JSON-like array string format
def employeeIdsArray = employeeIds.collect { &quot;\&quot;&quot; + it + &quot;\&quot;&quot; } // Enclose each ID in quotes
def jsonArrayString = &quot;[&quot; + employeeIdsArray.join(&quot;,&quot;) + &quot;]&quot; // Join elements with commas and surround with brackets
def jsonString = employeeIds.join(&quot;,&quot;) // Join elements with commas

// Log the resulting JSON array string
log.info(&quot;Generated Employee IDs Array: &quot; + jsonArrayString)
log.info(&quot;Generated Employee IDs Array: &quot; + jsonString)

// Optionally store the JSON array string in a JMeter variable for later use
vars.put(&quot;employeeIdsArray&quot;, jsonArrayString)
vars.put(&quot;employeeIds&quot;, jsonString)</stringProp>
