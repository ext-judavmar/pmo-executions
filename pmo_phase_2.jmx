                <stringProp name="script">import org.apache.jmeter.protocol.http.control.CookieManager
import org.apache.jmeter.protocol.http.control.Cookie

// Get the Cookie Manager
CookieManager manager = sampler.getCookieManager()
if (manager != null) {
    // Retrieve the CSRF value from the JMeter variables
    String csrfValue = vars.get(&quot;X-Uaa-Csrf&quot;)
    //log.info(&quot;Retrieved X-Uaa-Csrf value: &quot; + csrfValue) // Log the retrieved value

    if (csrfValue != null) {
        // Create and add the CSRF cookie
        Cookie csrfCookie = new Cookie()
        csrfCookie.setName(&quot;X-Uaa-Csrf&quot;)
        csrfCookie.setValue(csrfValue)
        csrfCookie.setDomain(&quot;${URL}&quot;) // Adjust the domain as needed
        csrfCookie.setPath(&quot;/&quot;) // Set the path for the cookie
        csrfCookie.setSecure(false) // Set to true if the cookie should be secure
        manager.add(csrfCookie)
       // log.info(&quot;CSRF Cookie added: &quot; + csrfCookie.toString())
    } else {
       // log.error(&quot;Variable X-Uaa-Csrf is not defined.&quot;)
    }

    // Retrieve the JSESSIONID value from the JMeter variables
    String jsessionidValue = vars.get(&quot;JSESSIONID&quot;)
    //log.info(&quot;Retrieved JSESSIONID value: &quot; + jsessionidValue) // Log the retrieved value

    if (jsessionidValue != null) {
        // Create and add the JSESSIONID cookie
        Cookie jsessionidCookie = new Cookie()
        jsessionidCookie.setName(&quot;JSESSIONID&quot;)
        jsessionidCookie.setValue(jsessionidValue)
        jsessionidCookie.setDomain(&quot;${URL}&quot;) // Adjust the domain as needed
        jsessionidCookie.setPath(&quot;/&quot;) // Set the path for the cookie
        jsessionidCookie.setSecure(false) // Set to true if the cookie should be secure
        manager.add(jsessionidCookie)
      //  log.info(&quot;JSESSIONID Cookie added: &quot; + jsessionidCookie.toString())
    } else {
       // log.error(&quot;Variable JSESSIONID is not defined.&quot;)
    }

    // Retrieve the __VCAP_ID__ value from the JMeter variables
    String vcapIdValue = vars.get(&quot;__VCAP_ID__&quot;)
   // log.info(&quot;Retrieved __VCAP_ID__ value: &quot; + vcapIdValue) // Log the retrieved value

    if (vcapIdValue != null) {
        // Create and add the __VCAP_ID__ cookie
        Cookie vcapIdCookie = new Cookie()
        vcapIdCookie.setName(&quot;__VCAP_ID__&quot;)
        vcapIdCookie.setValue(vcapIdValue)
        vcapIdCookie.setDomain(&quot;${URL}&quot;) // Adjust the domain as needed
        vcapIdCookie.setPath(&quot;/&quot;) // Set the path for the cookie
        vcapIdCookie.setSecure(false) // Set to true if the cookie should be secure
        manager.add(vcapIdCookie)
        log.info(&quot;__VCAP_ID__ Cookie added: &quot; + vcapIdCookie.toString())
    } else {
        //log.error(&quot;Variable __VCAP_ID__ is not defined.&quot;)
    }

} else {
    //log.error(&quot;No CookieManager found for the sampler.&quot;)
}</stringProp>
