                      <stringProp name="cacheKey">true</stringProp>
                      <stringProp name="script">import groovy.json.JsonSlurper

// Get the response body from the previous HTTP Request
def responseBody = prev.getResponseDataAsString()

// Store the JSON response in a JMeter variable
vars.put(&quot;jsonFilteredResponse&quot;, responseBody)

// Log to confirm the variable is set
//log.info(&quot;Captured JSON Response: &quot; + responseBody)

// Parse the JSON response
def jsonSlurper = new JsonSlurper()
def jsonArray

try {
    // Assuming the response is a JSON array
    jsonArray = jsonSlurper.parseText(responseBody) // Parse the JSON response
} catch (Exception e) {
    //log.error(&quot;Failed to parse JSON response: &quot; + e.message)
    return
}

// Initialize counter for &apos;id&apos; values
int filteredIdCount = 0

// Iterate through the array and extract &apos;id&apos; values
jsonArray.eachWithIndex { item, index -&gt;
    if (item instanceof Map &amp;&amp; item.containsKey(&apos;id&apos;)) {
        // Create a variable name like employId_0, employId_1, etc.
        String employeeIdVariable = &quot;employeeId_&quot; + index
        // Store the &apos;id&apos; in the variable
        vars.put(employeeIdVariable, item.id.toString())
        //log.info(&quot;Stored &quot; + employeeIdVariable + &quot;: &quot; + item.id) // Log the stored id
        filteredIdCount++ // Increment idCount for each &apos;id&apos; found
    }
}

// Log the total number of &apos;id&apos; values stored
//log.info(&quot;Total number of &apos;id&apos; values stored: &quot; + filteredIdCount)

// Optionally, store the count in a JMeter variable for later use
vars.put(&quot;filteredIdCount&quot;, filteredIdCount.toString())</stringProp>
